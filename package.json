{
  "name": "knitui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Knit UI — a cross-platform (React Native + Web) component kit and design system.",
  "license": "MIT",
  "author": "The Haus <joost@the.haus>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-haus/knitui.git"
  },
  "bugs": {
    "url": "https://github.com/the-haus/knitui/issues"
  },
  "homepage": "https://github.com/the-haus/knitui#readme",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build --filter='!@knitui/docs'",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "start": "pnpm --filter @knitui/example start",
    "web": "pnpm --filter @knitui/example web",
    "ios": "pnpm --filter @knitui/example ios",
    "android": "pnpm --filter @knitui/example android",
    "next": "pnpm --filter @knitui/web dev",
    "docs": "pnpm --filter @knitui/docs dev",
    "docs:build": "pnpm --filter @knitui/docs build",
    "docs:generate": "node scripts/docs/generate.mjs",
    "docs:check": "node scripts/docs/check-coverage.mjs",
    "docs:check:highlight": "node scripts/docs/check-live-highlight.mjs",
    "docs:scaffold": "node scripts/docs/scaffold-pages.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "reflect:components": "scripts/reflect-components-codex.sh",
    "check:naming": "node scripts/check-naming.mjs --all",
    "test": "turbo run test --concurrency=1",
    "prepare": "git config core.hooksPath .husky || true",
    "version-packages": "changeset version && pnpm install --lockfile-only && pnpm docs:generate",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.25.0",
    "@next/eslint-plugin-next": "^16.3.5",
    "@react-native/metro-config": "0.86.3",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "react-native-builder-bob": "^0.43.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-native": "0.86.3",
      "@react-native/metro-config": "0.86.3",
      "react-native-reanimated": "4.5.1",
      "react-native-worklets": "0.10.1",
      "@shopify/react-native-skia": "2.6.2",
      "react-native-teleport": "1.2.2",
      "@maplibre/maplibre-react-native": "11.4.0",
      "@maplibre/maplibre-gl-style-spec": "26.4.4"
    },
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "@swc/core",
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "@tamagui/animations-css@2.7.7": "patches/@tamagui__animations-css@2.7.7.patch",
      "@tamagui/static@2.7.7": "patches/@tamagui__static@2.7.7.patch",
      "expo-modules-core@57.0.18": "patches/expo-modules-core@57.0.18.patch",
      "expo-audio@57.0.5": "patches/expo-audio@57.0.5.patch"
    }
  }
}
