{
  "expo": {
    "name": "Knit UI Example",
    "slug": "knitui-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "knitui",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thehaus.knituiexample"
    },
    "android": {
      "package": "com.thehaus.knituiexample"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "@knitui/media",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone.",
          "backgroundPlayback": true,
          "pictureInPicture": true
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-image"
    ]
  }
}
