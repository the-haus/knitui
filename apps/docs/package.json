{
  "name": "@knitui/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The Knit UI documentation website — every component and package, documented from the sources that already exist.",
  "license": "MIT",
  "scripts": {
    "generate": "node ../../scripts/docs/generate.mjs",
    "dev": "pnpm generate && next dev --webpack --port 3001",
    "build": "pnpm generate && next build --webpack && pnpm postbuild",
    "postbuild": "node ./scripts/postbuild.mjs",
    "start": "npx serve out -p 3001",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rimraf .next out .turbo src/generated"
  },
  "dependencies": {
    "@knitui/carousel": "workspace:*",
    "@knitui/components": "workspace:*",
    "@knitui/core": "workspace:*",
    "@knitui/dates": "workspace:*",
    "@knitui/emoji": "workspace:*",
    "@knitui/graphics": "workspace:*",
    "@knitui/hooks": "workspace:*",
    "@knitui/icons": "workspace:*",
    "@knitui/map": "workspace:*",
    "@knitui/media": "workspace:*",
    "@knitui/mediaquery": "workspace:*",
    "@knitui/plugins": "workspace:*",
    "@knitui/sheet": "workspace:*",
    "@knitui/story-runtime": "workspace:*",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.3.5",
    "@shopify/react-native-skia": "2.6.2",
    "maplibre-gl": "^6.10.0",
    "next": "^16.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-teleport": "1.2.2"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "pagefind": "^1.4.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rimraf": "^6.0.1",
    "shiki": "^4.4.3",
    "typescript": "~6.0.3"
  }
}
