# Cloudflare Pages per-path response headers.
#
# Lives in public/ so `next build` copies it to the root of out/, which is where
# Pages looks for it. `.github/workflows/docs.yml` asserts out/_headers exists, so
# a rename here fails the build instead of silently dropping these headers.
#
# Rules are matched most-specific-first; a path only picks up the blocks it
# matches, so the /* block below is not inherited by the ones above it.

# Content-hashed by the bundler — the URL changes whenever the bytes do, so this
# can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The Pagefind index is rebuilt on every deploy and its fragment filenames are
# content-derived, but the entry point (pagefind.js) is not — keep it short.
/pagefind/*
  Cache-Control: public, max-age=3600, must-revalidate

# Regenerated every deploy; crawlers should not hold a stale copy.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # SAMEORIGIN rather than DENY: the docs embed their own routes and the
  # Storybook build in iframes.
  X-Frame-Options: SAMEORIGIN
  # Deliberately no Permissions-Policy. The live demos need real device access —
  # /docs/media/audio-recorder asks for the microphone — and a restrictive
  # default here silently breaks them with no error a reader could act on.
