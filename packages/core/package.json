{
  "name": "@knitui/core",
  "version": "1.0.0",
  "description": "Design tokens, theme and cross-platform primitives for Knit UI.",
  "license": "MIT",
  "author": "The Haus <joost@the.haus>",
  "homepage": "https://github.com/the-haus/knitui/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-haus/knitui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/the-haus/knitui/issues"
  },
  "keywords": [
    "knitui",
    "react-native",
    "react-native-web",
    "expo",
    "cross-platform",
    "tokens",
    "theme",
    "tamagui"
  ],
  "source": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "source": "./src/config/config.ts",
      "react-native": "./src/config/config.ts",
      "types": "./lib/typescript/config/config.d.ts",
      "default": "./src/config/config.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/*.test.*",
    "!**/*.stories.*",
    "!**/__tests__/**",
    "!**/__mocks__/**"
  ],
  "sideEffects": false,
  "dependencies": {
    "@tamagui/animate-presence": "3.0.18",
    "@tamagui/animations-css": "3.0.18",
    "@tamagui/animations-reanimated": "3.0.18",
    "@tamagui/colors": "3.0.18",
    "@tamagui/config-v5": "3.0.18",
    "@tamagui/core": "3.0.18",
    "@tamagui/element": "3.0.18",
    "@tamagui/focusable": "3.0.18",
    "@tamagui/native": "3.0.18",
    "@tamagui/react-native-media-driver": "3.0.18",
    "@tamagui/web": "3.0.18",
    "react-native-teleport": "1.2.2"
  },
  "scripts": {
    "generate:themes": "node scripts/generate-themes.mjs",
    "build": "node scripts/generate-themes.mjs && bob build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rimraf lib .turbo"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@tamagui/build": "3.0.18",
    "@types/jest": "^29.5.12",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^58.0.17",
    "esbuild": "0.28.1",
    "jest": "^29.7.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.43.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-web": "~0.21.4"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
